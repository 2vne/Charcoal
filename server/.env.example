PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# Supabase Credentials
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI API Key for Agentic Intelligence
OPENAI_API_KEY=your_openai_api_key_here

# 1. Weather Services (Default: Open-Meteo Free Service - No key required)
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast

# 2. Road Routing Services (TomTom Traffic Routing primary, OSRM fallback)
routingTomTomApi=your_tomtom_api_key
ROUTING_API_URL=https://router.project-osrm.org

# 3. Real-Time Disaster Intelligence APIs (Default: Open USGS & NASA EONET)
USGS_DISASTER_API_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
NASA_EONET_API_URL=https://eonet.gsfc.nasa.gov/api/v3/events


